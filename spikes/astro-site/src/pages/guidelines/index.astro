---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guidelines = await getCollection('guidelines');
---

<Base
  title="WSG guidelines"
  description="Every guideline in the W3C Web Sustainability Guidelines release that WSG-Check targets."
>
  <div class="md" style="max-width:56rem;margin:0 auto;padding:4rem 1rem">
    <h1>WSG guidelines ({guidelines.length})</h1>
    <ul>
      {
        guidelines.map((g) => (
          <li>
            <a href={`/guidelines/${g.id}/`}>{g.data.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
