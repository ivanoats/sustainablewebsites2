---
import { getEntry, render } from 'astro:content';
import { css } from '@/styled-system/css';
import { Link } from '@/components/Link';
import CardShell from '../components/CardShell';
import Base from '../layouts/Base.astro';

const entry = await getEntry('about', 'about');
if (!entry) throw new Error('content/about.md is missing');
const { Content } = await render(entry);
const { title, description, heading, sources } = entry.data;

const hero = css({
  py: { base: '3rem', md: '4rem' },
  px: '1rem',
  bg: 'surface.100',
  borderBottomWidth: '1px',
  borderBottomStyle: 'solid',
  borderColor: 'border',
});
const inner = css({ maxW: '4xl', mx: 'auto' });
const h1 = css({
  fontSize: { base: '3xl', md: '4xl' },
  fontWeight: 'bold',
  color: 'ink',
});
const section = css({ py: '4rem', px: '1rem', maxW: '4xl', mx: 'auto' });
const footer = css({ mt: '2rem', color: 'ink.muted', fontSize: 'bodySm' });
---

<Base title={title} description={description}>
  <div>
    <section class={hero} aria-label="About us">
      <div class={inner}>
        <h1 class={h1}>{heading}</h1>
      </div>
    </section>

    <section class={section}>
      <CardShell>
        <article class="md"><Content /></article>
      </CardShell>

      <footer class={footer}>
        <p>
          Sources:{' '}
          {
            sources.map((source, i) => (
              <Fragment>
                {i > 0 && ', '}
                <Link href={source.href} external variant="subtle">
                  {source.label}
                </Link>
              </Fragment>
            ))
          }
        </p>
      </footer>
    </section>
  </div>
</Base>
