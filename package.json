{
  "name": "sustainable-websites-com",
  "version": "2.0.0",
  "description": "Website for marketing green website services",
  "license": "none",
  "author": "Ivan Storck",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "panda:codegen": "panda codegen",
    "panda:css": "panda cssgen",
    "panda:gen": "npm run panda:codegen && npm run panda:css",
    "predev": "npm run panda:gen",
    "pretype-check": "npm run panda:gen && next typegen",
    "prebuild": "npm run panda:gen",
    "pretest": "npm run panda:gen",
    "pretest:run": "npm run panda:gen",
    "pretest:coverage": "npm run panda:gen",
    "pretest:ui": "npm run panda:gen",
    "prescreenshots:before": "npm run panda:gen",
    "prescreenshots:after": "npm run panda:gen",
    "prescreenshots": "npm run panda:gen",
    "prestorybook": "npm run panda:gen",
    "prebuild-storybook": "npm run panda:gen",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint-staged": "lint-staged",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "screenshots:before": "cross-env SCREENSHOT_DIR=screenshots/before playwright test e2e/screenshots.spec.ts",
    "screenshots:after": "cross-env SCREENSHOT_DIR=screenshots/after playwright test e2e/screenshots.spec.ts",
    "screenshots": "cross-env SCREENSHOT_DIR=screenshots/manual playwright test e2e/screenshots.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write",
    "*.md": [
      "markdownlint-cli2",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@pandacss/dev": "^1.10.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.575.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "browserslist": "^4.28.7",
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2"
  }
}
