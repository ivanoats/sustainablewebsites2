---
import { getEntry, render } from 'astro:content';
import { css } from '@/styled-system/css';
import { CTAButton } from '@/components/CTAButton';
import Base from '../layouts/Base.astro';

const entry = await getEntry('wsgCheck', 'wsg-check');
if (!entry) throw new Error('content/wsg-check.md is missing');
const { Content } = await render(entry);
const { title, description, heading, intro, cta } = entry.data;

const page = css({ bg: 'surface.200' });
const hero = css({
  py: '4rem',
  px: '1rem',
  bg: 'surface.100',
  color: 'ink',
  textAlign: 'center',
});
const inner = css({ maxW: '4xl', mx: 'auto' });
const h1 = css({ fontSize: '3xl', fontWeight: 'bold', mb: '1rem' });
const lead = css({ fontSize: 'displaySm', lineHeight: '1.8' });
const body = css({ py: '4rem', px: '1rem', maxW: '4xl', mx: 'auto' });
const ctaRow = css({ textAlign: 'center', mt: '2rem' });
---

<Base title={title} description={description}>
  <div class={page}>
    <section class={hero} aria-label="WSG Check tool">
      <div class={inner}>
        <h1 class={h1}>{heading}</h1>
        <p class={lead}>{intro}</p>
      </div>
    </section>

    <section class={body}>
      <div class="md md--check"><Content /></div>
      <div class={ctaRow}>
        <CTAButton text={cta.label} href={cta.href} variant="primary" size="lg" />
      </div>
    </section>
  </div>
</Base>
